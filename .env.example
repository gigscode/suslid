NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PAYSTACK_SECRET_KEY=

# Free LangSearch API key — get at https://langsearch.com/dashboard
# No credit card. Required for lead discovery in production.
LANGSEARCH_API_KEY=

# Python scraper service on Railway (set after you deploy the scraper)
# Format: https://your-service-name.railway.app
SCRAPER_SERVICE_URL=

# Secret key shared between Next.js and the Python scraper
# Use any random string — e.g. run: openssl rand -hex 32
SCRAPER_SECRET=

# Optional: proxy URL for the scraper (Webshare free tier works)
# Format: http://username:password@proxy-host:port
PROXY_URL=
